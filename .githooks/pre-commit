#!/bin/sh
# Pre-commit: (0) no secrets or key files, (1) no debug dumps in added lines, (2) php-cs-fixer, PHPStan and Deptrac on staged PHP files.
cd "$(git rev-parse --show-toplevel)" || exit 1

# 0. Secrets: never commit key files, local env files or private-key material (runs on every commit).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
KEY_FILES=$(echo "$STAGED" | grep -E '\.(pem|key|p12|pfx)$|(^|/)\.env\.([^/]*\.)?local$|(^|/)id_(rsa|ed25519|ecdsa)$')
KEY_BODIES=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+[^+]' | grep -E -e '-----BEGIN [A-Z ]*PRIVATE[ ]KEY-----')
if [ -n "$KEY_FILES" ] || [ -n "$KEY_BODIES" ]; then
  echo "pre-commit: secrets in staged changes (JWT keys, local env files, private keys). Never commit these:" >&2
  [ -n "$KEY_FILES" ] && echo "$KEY_FILES" >&2
  [ -n "$KEY_BODIES" ] && echo "(private key material found in added lines)" >&2
  echo "Unstage with: git restore --staged <file>. JWT keys live in config/jwt/ (git-ignored); the passphrase goes in the git-ignored local env file." >&2
  exit 1
fi

FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|twig)$')
[ -z "$FILES" ] && exit 0

# 1. Debug leftovers (only lines being added in this commit)
DUMPS=$(git diff --cached -U0 --diff-filter=ACMR -- $FILES | grep -E '^\+[^+]' \
  | grep -E '(^\+|[^A-Za-z0-9_>:$])(dump|dd|dumpe|var_dump|var_export|print_r|ray|error_log)\(|\{\{\s*dump\(|\{%\s*dump\b')
if [ -n "$DUMPS" ]; then
  echo "pre-commit: debug dump found in staged changes:" >&2
  echo "$DUMPS" >&2
  exit 1
fi

# 2. Style, PHPStan, Deptrac (run in Docker, see AGENTS.md)
PHP_FILES=$(echo "$FILES" | grep '\.php$')
[ -z "$PHP_FILES" ] && exit 0
if ! docker compose exec -T php true >/dev/null 2>&1; then
  echo "pre-commit: php container is not running (docker compose up -d)." >&2
  exit 1
fi
PHP="docker compose exec -T php"

# shellcheck disable=SC2086
OUT=$($PHP vendor/bin/php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php --path-mode=intersection -- $PHP_FILES 2>&1) || {
  echo "pre-commit: code style violations:" >&2; echo "$OUT" >&2
  echo "Fix with: docker compose exec -T php vendor/bin/php-cs-fixer fix   (then git add)" >&2; exit 1; }

# shellcheck disable=SC2086
OUT=$($PHP vendor/bin/phpstan analyse --no-progress --error-format=raw $PHP_FILES 2>&1) || {
  echo "pre-commit: PHPStan errors:" >&2; echo "$OUT" >&2; exit 1; }

# Deptrac checks layer rules across files, so it runs on the whole project.
OUT=$($PHP vendor/bin/deptrac analyse --no-progress 2>&1) || {
  echo "pre-commit: Deptrac violations:" >&2; echo "$OUT" >&2; exit 1; }
