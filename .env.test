# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Throw-away JWT keys for tests only (generated by tests/bootstrap.php into var/, git-ignored).
# The test environment never reads the local env file, so real keys are not used here.
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt/test-private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt/test-public.pem
JWT_PASSPHRASE=test
