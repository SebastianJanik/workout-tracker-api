# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# JWT in tests: a shared-secret algorithm (HS256, see config/packages/lexik_jwt_authentication.yaml),
# so no key files are needed. Throw-away value, never used outside the test environment.
JWT_SECRET_KEY=test-only-jwt-secret-not-used-outside-the-test-environment
JWT_PUBLIC_KEY=
JWT_PASSPHRASE=
